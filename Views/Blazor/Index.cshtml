
@{
    ViewData["Title"] = "Index";

    bool IsBlazorEnabled = ViewData["IsBlazorEnabled"] != null && (bool)ViewData["IsBlazorEnabled"];
}

<h1>Blazor Sample</h1>

@if (IsBlazorEnabled)
{
    <p>This is a Blazor component rendered inside an MVC view:</p>
    @* <component type="typeof(NetMvcWithBlazor.Components.Counter)" render-mode="ServerPrerendered" /> *@
    @(await Html.RenderComponentAsync<NetMvcWithBlazor.Views.Shared.Component.Component>(RenderMode.ServerPrerendered, new { Data = " Hello World " }))
}
else
{
    <div class="alert alert-warning" role="alert">
        Blazor is not enabled. Please ensure that the Blazor services are configured in Startup.cs or Program.cs.
    </div>
}


