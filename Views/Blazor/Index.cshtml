
@{
    ViewData["Title"] = "Index";

    bool IsBlazorEnabled = ViewData["IsBlazorEnabled"] != null && (bool)ViewData["IsBlazorEnabled"];
}
@* <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
<link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" /> *@

<h4>Blazor Sample</h4>

@if (IsBlazorEnabled)
{    
    @* <component type="typeof(NetMvcWithBlazor.Views.Shared.Component.NormalCounter)" render-mode="ServerPrerendered" /> *@
    @(await Html.RenderComponentAsync<NetMvcWithBlazor.Views.Shared.Component.NormalCounter>(RenderMode.ServerPrerendered, new { Data = " Hello World " }))
}
else
{
    <div class="alert alert-warning" role="alert">
        Blazor is not enabled. Please ensure that the Blazor services are configured in Startup.cs or Program.cs.
        <br />
        Make sure appsettings.Development.json has following -> "IsBlazorEnabled": true
    </div>
}


