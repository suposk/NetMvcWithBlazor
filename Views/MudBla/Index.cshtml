@{

    ViewData["Title"] = "Index";

    bool IsBlazorEnabled = ViewData["IsBlazorEnabled"] != null && (bool)ViewData["IsBlazorEnabled"];
}

<h4>MudBlazor Sample in MVC</h4>

@if (IsBlazorEnabled)
{
    <p>MudBlazor</p>

    <component type="typeof(NetMvcWithBlazor.Views.Shared.Component.MudCounter)" render-mode="ServerPrerendered" />
 @*    @(await Html.RenderComponentAsync<NetMvcWithBlazor.Views.Shared.Component.MudCounter>(RenderMode.ServerPrerendered))
 *@
}
else
{
    <div class="alert alert-warning" role="alert">
        Blazor is not enabled. Please ensure that the Blazor services are configured in Startup.cs or Program.cs.
        <br/>
        Make sure appsettings.Development.json has following -> "IsBlazorEnabled": true
    </div>
}


