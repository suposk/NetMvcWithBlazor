
<MudWrapperComp>

    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
        <MudTabPanel Text="Button">
            <MudText Typo="Typo.h6">
                MudBlazor is @Text
            </MudText>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="ButtonOnClick">
                @ButtonText
            </MudButton>
        </MudTabPanel>

        <MudTabPanel Text="Dialogs">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="ShowMessage">
                Show Message
            </MudButton>

            <br />
            <br />
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="OpenDialog">
                Open Dialog
            </MudButton>

            <br />
            <br />
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="OpenDialogWithEntry">
                Open Dialog with entry
            </MudButton>
        </MudTabPanel>

        <MudTabPanel Text="MudSimpleTable">
            <SimpleTableComp></SimpleTableComp>
        </MudTabPanel>
        
        <MudTabPanel Text="Tab Disabled" Disabled="true">
            <MudText>Content Disabled</MudText>
        </MudTabPanel>

    </MudTabs>


</MudWrapperComp>

@code {
    [Inject]
    public ICustomDialogService CustomDialogService { get; set; }

    string Text { get; set; } = "Some text ????";
    string ButtonText { get; set; } = "Click Me";
    int ClickCount { get; set; }

    void ButtonOnClick()
    {
        ClickCount += 1;
        Text = $"Awesome x {ClickCount}";
        ButtonText = "Click Me Again";
    }

   async Task ShowMessage()
   {
       // Dialog logic here
       await  CustomDialogService.ShowMessage("Title Dialog!", "This is some text");
   }

   async Task OpenDialog()
   {
       // Dialog logic here
       var res = await CustomDialogService.ShowDialog(title: "Title Dialog!", text: "Show some text in dialog");
   }

   async Task OpenDialogWithEntry()
   {
       // Dialog logic here
       var res = await CustomDialogService.ShowDialogWithEntry(title: "Title Dialog entry!", text: "Show some text in dialog");
   }
      

}