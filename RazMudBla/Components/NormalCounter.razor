
<h3>Blazor Component in MVC</h3>
<button @onclick="Test" class="btn btn-dark">Click to get answer</button>
<br />
<div>Param @Data </div>
<div>Button clicked @Counter times.</div>

@code {
    [Parameter]
    public string Data { get; set; } = string.Empty;

    public int Counter { get; set; } = 0;

    private void Test ()
    {
        Data = "Button Clicked";
        Counter++;
    }
}