@{

    ViewData["Title"] = "Index";

    bool IsBlazorEnabled = ViewData["IsBlazorEnabled"] != null && (bool)ViewData["IsBlazorEnabled"];
}

<h4>Tool Sample in MVC</h4>

@if (IsBlazorEnabled)
{
    <component type="typeof(RazMudBla.Components.ToolComp)" render-mode="ServerPrerendered" />
 
    @* Necessary to include the Blazor script *@
    <script src="_framework/blazor.server.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
}
else
{
    <div class="alert alert-warning" role="alert">
        Blazor is not enabled. Please ensure that the Blazor services are configured in Startup.cs or Program.cs.
        <br/>
        Make sure appsettings.Development.json has following -> "IsBlazorEnabled": true
    </div>
}


